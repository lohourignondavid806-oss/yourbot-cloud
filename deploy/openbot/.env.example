# Copy this file to .env on the VPS. Do not commit the copied file.
# This file contains no provider, Boat, or GHCR credential.

# Use the lower-case GHCR image path created by openbot-docker-ghcr.yml.
OPENBOT_IMAGE=ghcr.io/your-org/yourbot-openbot
# Prefer an immutable version or sha-* tag. Do not use latest for the first test.
OPENBOT_TAG=replace-with-tested-tag

# Keep the first environment unique. Use a new volume and network name per tenant later.
OPENBOT_CONTAINER_NAME=yourbot-openbot-prototype
OPENBOT_VOLUME_NAME=yourbot-openbot-prototype-data
OPENBOT_NETWORK_NAME=yourbot-openbot-prototype
OPENBOT_SECCOMP_PROFILE=../../docker/seccomp.json

# Initial conservative limits for the 8 vCPU / 32 GB VPS.
OPENBOT_CPUS=2.0
OPENBOT_MEMORY=8g
OPENBOT_PIDS=8192
OPENBOT_SHM_SIZE=1g
OPENBOT_TMP=4g
OPENBOT_DISPLAY_SIZE=1280x800

# Optional. Leave empty when using the default OpenBot account service.
# OPENBOT_AUTH_API_URL=https://your-account-service.example.com
